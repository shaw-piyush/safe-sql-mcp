# copy to .env (gitignored) and fill in

# owner role, only used by db/load.py to create the schema and load the CSVs
DATABASE_URL=postgresql://owner:CHANGE_ME@localhost:5432/olist

# read-only role used by the MCP server and the integration tests
DATABASE_URL_READONLY=postgresql://agent_ro:CHANGE_ME@localhost:5432/olist

# key for the agent; put a hard monthly spend cap on the account first
ANTHROPIC_API_KEY=

AGENT_MODEL=claude-haiku-5-5

# required for Streamable HTTP mode; the server won't start in that mode without it
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=
